# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# The local development Home Assistant (dev/compose.yaml); only its
# configuration.yaml is tracked
dev/config/*
!dev/config/configuration.yaml

# Editors and macOS: the shared VS Code setup is tracked, personal files aren't
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
